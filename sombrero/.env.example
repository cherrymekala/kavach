# Local dev: use a free AI Studio key. Deployed: USE_VERTEX=true and no key.
GOOGLE_API_KEY=
USE_VERTEX=false
GCP_PROJECT=kavach-prod
GCP_REGION=asia-south1
# Check current model names in the Gemini docs before changing these.
MODEL_FAST=gemini-3.8-flash
MODEL_REASONING=gemini-3.5-flash-lite
DOCS_BUCKET=kavach-prod-docs
RULINGS_DATA_STORE=
AUTH_DISABLED=true
