# Local dev: use a free AI Studio key. Deployed: USE_VERTEX=true and no key.
GOOGLE_API_KEY=
USE_VERTEX=false
GCP_PROJECT=kavach-510312
GCP_REGION=asia-south1
MODEL_FAST=gemini-3.5-flash-lite
MODEL_REASONING=gemini-3.8-flash
DOCS_BUCKET=kavach-510312-docs
RULINGS_ENGINE=kavach-rulings
AUTH_DISABLED=true
PACKS_DIR=magellan/packs
LIVE_MODEL=gemini-live-2.5-flash-native-audio
LIVE_LOCATION=us-central1

# Phone line (Twilio). PUBLIC_URL = the https URL Twilio calls (it signs that exact URL).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
PUBLIC_URL=

# WhatsApp (Meta Cloud API). In developers.facebook.com create a Business app, add the
# WhatsApp product (this gives you the test number and a WhatsApp Business Account), then:
#   WHATSAPP_PHONE_NUMBER_ID  WhatsApp → API Setup → "Phone number ID"
#   WHATSAPP_ACCESS_TOKEN     a permanent token from a Business system user holding the
#                             whatsapp_business_messaging permission. Temporary tokens
#                             expire within hours, so they cannot back a webhook.
#   WHATSAPP_APP_SECRET       App settings → Basic → App secret; verifies every webhook
#   WHATSAPP_VERIFY_TOKEN     any random string; paste the same value into the webhook setup
# Point the app's webhook at https://<host>/whatsapp/webhook and subscribe to "messages".
# WHATSAPP_TEMPLATE is only needed for reminders sent more than 24 hours after the patient's
# last message, because Meta rejects free-form messages outside that window.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=kavach-verify
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
# Local dev only: log outbound messages instead of calling Meta.
WHATSAPP_DRY_RUN=true

# Payments (appeal pack). Off by default: everything is free.
PAYMENTS_ENABLED=false
# India: Razorpay test keys (dashboard -> Account & Settings -> API keys, Test mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Singapore/Malaysia: Stripe test keys; webhook endpoint = <API>/payments/stripe/webhook, event checkout.session.completed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
APP_URL=https://kavach-510312.web.app
