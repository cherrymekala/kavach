rules_version = '2';
// The browser may only read its own case (for live progress). All writes go through the API,
// which uses a service account and is not subject to these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /cases/{caseId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.owner;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
