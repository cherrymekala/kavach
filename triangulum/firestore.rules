rules_version = '2';
// The browser may only read a case it owns or was invited to help with (for live progress).
// All writes go through the API, which uses a service account and is not subject to these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /cases/{caseId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.owner
            || request.auth.uid in resource.data.get('helper_ids', []));
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
