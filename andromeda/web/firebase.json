{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/",
        "destination": "/index.html"
      },
      {
        "source": "/app",
        "destination": "/index.html"
      },
      {
        "source": "/case/**",
        "destination": "/index.html"
      },
      {
        "source": "/join",
        "destination": "/index.html"
      },
      {
        "source": "/join/**",
        "destination": "/index.html"
      },
      {
        "source": "/insights",
        "destination": "/index.html"
      },
      {
        "source": "/insights/**",
        "destination": "/index.html"
      }
    ],
    "cleanUrls": true,
    "trailingSlash": false
  }
}
