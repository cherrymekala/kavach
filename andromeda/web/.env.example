# Kavach web app — environment variables (copy to .env, never commit .env)
# The backend API (Cloud Run).
VITE_API_URL=https://sombrero-urb5ttky3q-el.a.run.app

# Firebase web app config — Firebase console → Project settings → Your apps → Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=kavach-510312
# Storage bucket is not needed — documents go to our own Cloud Storage bucket via the backend.
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# The WhatsApp Cloud API number, in international form without "+" (Meta → WhatsApp → API
# Setup). It powers the "chat on WhatsApp" link in the account menu; leave it empty to hide
# the link. The bot answers on that number — this only tells the web app where to point.
VITE_WHATSAPP_NUMBER=